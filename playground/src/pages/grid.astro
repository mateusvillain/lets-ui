---
import '@lets-ui/tokens';
import '@lets-ui/styles';

const posts = [
  {
    tag: 'Fundamentos',
    title: 'Tokens que não mentem',
    excerpt:
      'Por que todo valor de design precisa nascer de um token e nunca de um número solto no CSS.',
  },
  {
    tag: 'Layout',
    title: 'Doze colunas, três breakpoints',
    excerpt:
      'A grade responde ao viewport sozinha. O autor só decide quantas colunas cada bloco ocupa.',
  },
  {
    tag: 'Componentes',
    title: 'Web Components sem framework',
    excerpt:
      'Custom elements puros, shadow DOM e a mesma folha de estilo do CSS global.',
  },
  {
    tag: 'Acessibilidade',
    title: 'Foco visível por padrão',
    excerpt:
      'O focus-ring é token, não enfeite. Ele acompanha o tema e o brand automaticamente.',
  },
  {
    tag: 'Processo',
    title: 'Do Figma ao dist em um comando',
    excerpt:
      'Terrazzo compila o JSON, o Sass compila o CSS, o Vite empacota os componentes.',
  },
  {
    tag: 'Release',
    title: 'SemVer sem drama',
    excerpt:
      'Conventional Commits alimentam o changelog e o changelog alimenta a tag.',
  },
];

const stats = [
  { value: '4 / 8 / 12', label: 'colunas por breakpoint' },
  { value: '16 / 24', label: 'gap em px' },
  { value: '16 → 40', label: 'margem lateral' },
  { value: '1360px', label: 'largura máxima' },
];
---

<html lang="pt-BR" data-theme="light" data-brand="lets-ui">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Grid System — Let's UI Playground</title>
    <script>
      import '@lets-ui/components';
    </script>
  </head>

  <body>
    <!-- Overlay das colunas, alternável pelo botão do topo -->
    <div class="overlay" data-overlay hidden>
      <div class="grid overlay__grid">
        {
          Array.from({ length: 12 }, (_, i) => (
            <div class:list={['grid-item', 'overlay__col', `overlay__col--${i + 1}`]} />
          ))
        }
      </div>
    </div>

    <header class="site-header">
      <div class="grid site-header__inner">
        <div class="grid-item grid-item--1xs-full grid-item--sm-4 grid-item--lg-6 brand">
          <a href="/" class="brand__back">←</a>
          <span class="brand__name">Let's UI</span>
          <span class="brand__page">Grid</span>
        </div>

        <div
          class="grid-item grid-item--1xs-full grid-item--sm-4 grid-item--lg-6 site-header__actions"
        >
          <span class="readout" data-readout>—</span>
          <button class="toggle" data-toggle type="button" aria-pressed="false">
            Colunas
          </button>
        </div>
      </div>
    </header>

    <main>
      <!-- ── Hero ────────────────────────────────────────────────── -->
      <section class="grid section">
        <div
          class="grid-item grid-item--1xs-full grid-item--sm-6 grid-item--lg-8 hero"
        >
          <p class="eyebrow">Sistema de grid</p>
          <h1 class="hero__title">
            A grade decide.<br />Você só diz quantas colunas.
          </h1>
          <p class="hero__lead">
            Colunas, gap e margem lateral vêm do breakpoint. Nenhum componente
            desta página define <code>grid-template-columns</code>, gap ou
            padding horizontal — tudo é <code>.grid</code> e
            <code>.grid-item</code>.
          </p>
        </div>

        <div
          class="grid-item grid-item--1xs-full grid-item--sm-2 grid-item--lg-4 hero__aside"
        >
          <dl class="spec">
            <div class="spec__row"><dt>1xs</dt><dd>4 col · 16 · 16</dd></div>
            <div class="spec__row"><dt>sm</dt><dd>8 col · 16 · 32</dd></div>
            <div class="spec__row"><dt>md</dt><dd>8 col · 16 · 40</dd></div>
            <div class="spec__row"><dt>lg</dt><dd>12 col · 24 · 40</dd></div>
            <div class="spec__row"><dt>1xl</dt><dd>12 col · 24 · 1360</dd></div>
          </dl>
        </div>
      </section>

      <!-- ── Stats ───────────────────────────────────────────────── -->
      <section class="grid section">
        {
          stats.map((s) => (
            <div class="grid-item grid-item--1xs-2 grid-item--sm-2 grid-item--lg-3 stat">
              <strong class="stat__value">{s.value}</strong>
              <span class="stat__label">{s.label}</span>
            </div>
          ))
        }
      </section>

      <!-- ── Faixa full-bleed com grid aninhado ──────────────────── -->
      <section class="band">
        <div class="grid section">
          <div class="grid-item grid-item--1xs-full grid-item--sm-full grid-item--lg-4">
            <h2 class="section__title">Grid aninhado</h2>
            <p class="section__lead">
              A faixa é full-bleed, mas o conteúdo continua alinhado às mesmas
              colunas. O bloco à direita é um <code>.grid</code> dentro de um
              <code>.grid-item</code>: ele reparte a track do pai, sem reaplicar
              a margem de página.
            </p>
          </div>

          <div class="grid-item grid-item--1xs-full grid-item--sm-full grid-item--lg-8">
            <div class="grid">
              <div class="grid-item grid-item--1xs-2 grid-item--sm-4 grid-item--lg-4 nested">
                Aninhado A
              </div>
              <div class="grid-item grid-item--1xs-2 grid-item--sm-4 grid-item--lg-4 nested">
                Aninhado B
              </div>
              <div class="grid-item grid-item--1xs-full grid-item--sm-full grid-item--lg-4 nested">
                Aninhado C
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ── Cards ───────────────────────────────────────────────── -->
      <section class="grid section">
        <div class="grid-item grid-item--1xs-full">
          <h2 class="section__title">Cards</h2>
        </div>

        {
          posts.map((post) => (
            <article class="grid-item grid-item--1xs-full grid-item--sm-4 grid-item--lg-4 card">
              <span class="card__tag">{post.tag}</span>
              <h3 class="card__title">{post.title}</h3>
              <p class="card__excerpt">{post.excerpt}</p>
            </article>
          ))
        }
      </section>

      <!-- ── Conteúdo + trilho lateral ───────────────────────────── -->
      <section class="grid section">
        <div
          class="grid-item grid-item--1xs-full grid-item--sm-full grid-item--lg-8 prose"
        >
          <h2 class="section__title">Artigo</h2>
          <p>
            Em <code>1xs</code> o texto ocupa as 4 colunas e o trilho vai para
            baixo. Em <code>sm</code> e <code>md</code> ambos ocupam as 8
            colunas inteiras, empilhados. A partir de <code>lg</code> o artigo
            fica com 8 das 12 colunas e o trilho ocupa as 4 restantes.
          </p>
          <p>
            Nenhuma media query foi escrita nesta página. As três configurações
            saem das classes <code>--1xs-</code>, <code>--sm-</code> e
            <code>--lg-</code>, que cascateiam para cima até serem substituídas.
          </p>
        </div>

        <aside
          class="grid-item grid-item--1xs-full grid-item--sm-full grid-item--lg-4 rail"
        >
          <h3 class="rail__title">Nesta página</h3>
          <ul class="rail__list">
            <li>Header em 2 blocos</li>
            <li>Hero assimétrico</li>
            <li>Stats de largura fixa</li>
            <li>Faixa full-bleed</li>
            <li>Grid aninhado</li>
            <li>Cards uniformes</li>
            <li>Artigo + trilho</li>
          </ul>
        </aside>
      </section>

      <!-- ── Web Components ──────────────────────────────────────── -->
      <section class="grid section">
        <div class="grid-item grid-item--1xs-full">
          <h2 class="section__title">Mesma grade via Web Component</h2>
          <p class="section__lead">
            <code>&lt;lui-grid&gt;</code> e <code>&lt;lui-grid-item&gt;</code>
            compartilham a configuração com as classes CSS.
          </p>
        </div>

        <div class="grid-item grid-item--1xs-full">
          <lui-grid>
            <lui-grid-item span="full"
              ><div class="wc">span="full"</div></lui-grid-item
            >
            <lui-grid-item span="2" span-sm="4" span-lg="6"
              ><div class="wc">2 / 4 / 6</div></lui-grid-item
            >
            <lui-grid-item span="2" span-sm="4" span-lg="6"
              ><div class="wc">2 / 4 / 6</div></lui-grid-item
            >
            <lui-grid-item span="1" span-sm="2" span-lg="3"
              ><div class="wc">1 / 2 / 3</div></lui-grid-item
            >
            <lui-grid-item span="1" span-sm="2" span-lg="3"
              ><div class="wc">1 / 2 / 3</div></lui-grid-item
            >
            <lui-grid-item span="1" span-sm="2" span-lg="3"
              ><div class="wc">1 / 2 / 3</div></lui-grid-item
            >
            <lui-grid-item span="1" span-sm="2" span-lg="3"
              ><div class="wc">1 / 2 / 3</div></lui-grid-item
            >
          </lui-grid>
        </div>
      </section>
    </main>

    <footer class="grid section site-footer">
      <div class="grid-item grid-item--1xs-full grid-item--sm-4 grid-item--lg-6">
        <strong>Let's UI</strong> — Playground
      </div>
      <div
        class="grid-item grid-item--1xs-full grid-item--sm-4 grid-item--lg-6 site-footer__right"
      >
        <a href="/">Voltar</a>
      </div>
    </footer>

    <script is:inline>
      // Overlay das colunas + leitura do breakpoint ativo.
      const steps = [
        { name: '1xl', min: 1440 },
        { name: 'lg', min: 1280 },
        { name: 'md', min: 1024 },
        { name: 'sm', min: 768 },
        { name: '1xs', min: 0 },
      ];

      const overlay = document.querySelector('[data-overlay]');
      const toggle = document.querySelector('[data-toggle]');
      const readout = document.querySelector('[data-readout]');

      toggle.addEventListener('click', () => {
        const next = overlay.hidden;
        overlay.hidden = !next;
        toggle.setAttribute('aria-pressed', String(next));
      });

      function report() {
        const step = steps.find((s) => window.innerWidth >= s.min);
        const probe = document.querySelector('.site-header__inner');
        const styles = getComputedStyle(probe);

        readout.textContent = [
          step.name,
          `${window.innerWidth}px`,
          `${styles.getPropertyValue('--lui-grid-columns').trim()} col`,
          `gap ${styles.columnGap}`,
        ].join(' · ');
      }

      report();
      window.addEventListener('resize', report);
    </script>

    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
        background: var(--lui-color-neutral-background-surface, #fff);
        color: var(--lui-color-neutral-text-body, #1a1a1a);
      }

      code {
        font-family: ui-monospace, monospace;
        font-size: 0.875em;
        background: var(--lui-color-neutral-background-container, #eee);
        border-radius: var(--lui-border-radius-xs, 2px);
        padding: 1px 4px;
      }

      /* ── Overlay ─────────────────────────────────────────────── */
      .overlay {
        position: fixed;
        inset: 0;
        z-index: 100;
        pointer-events: none;
      }

      .overlay__grid {
        height: 100%;
      }

      .overlay__col {
        background: rgb(255 0 90 / 8%);
        border-inline: 1px solid rgb(255 0 90 / 20%);
      }

      /* Só existem 4 colunas em 1xs e 8 em sm/md — esconde o excedente. */
      .overlay__col--5,
      .overlay__col--6,
      .overlay__col--7,
      .overlay__col--8,
      .overlay__col--9,
      .overlay__col--10,
      .overlay__col--11,
      .overlay__col--12 {
        display: none;
      }

      @media (min-width: 768px) {
        .overlay__col--5,
        .overlay__col--6,
        .overlay__col--7,
        .overlay__col--8 {
          display: block;
        }
      }

      @media (min-width: 1280px) {
        .overlay__col--9,
        .overlay__col--10,
        .overlay__col--11,
        .overlay__col--12 {
          display: block;
        }
      }

      /* ── Header ──────────────────────────────────────────────── */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: var(--lui-color-neutral-background-surface, #fff);
        border-bottom: 1px solid var(--lui-color-neutral-border-subtle, #e6e6e6);
      }

      .site-header__inner {
        padding-block: var(--lui-spacing-fixed-16, 16px);
        align-items: center;
      }

      .brand {
        display: flex;
        align-items: baseline;
        gap: var(--lui-spacing-fixed-8, 8px);
      }

      .brand__back {
        text-decoration: none;
        color: inherit;
        opacity: 0.5;
      }

      .brand__name {
        font-weight: 700;
      }

      .brand__page {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        opacity: 0.5;
      }

      .site-header__actions {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: var(--lui-spacing-fixed-8, 8px);
      }

      @media (min-width: 768px) {
        .site-header__actions {
          justify-content: flex-end;
        }
      }

      .readout {
        font-family: ui-monospace, monospace;
        font-size: 0.6875rem;
        opacity: 0.6;
        white-space: nowrap;
      }

      .toggle {
        font: inherit;
        font-size: 0.75rem;
        padding: 6px 10px;
        cursor: pointer;
        border-radius: var(--lui-border-radius-sm, 4px);
        border: 1px solid var(--lui-color-neutral-border-default, #ccc);
        background: transparent;
        color: inherit;
      }

      .toggle[aria-pressed='true'] {
        background: rgb(255 0 90 / 12%);
        border-color: rgb(255 0 90 / 40%);
      }

      /* ── Seções ──────────────────────────────────────────────── */
      .section {
        padding-block: var(--lui-spacing-fluid-48, 48px);
      }

      .section__title {
        margin: 0 0 var(--lui-spacing-fixed-8, 8px);
        font-size: 1.25rem;
      }

      .section__lead {
        margin: 0;
        opacity: 0.7;
        line-height: 1.6;
      }

      .eyebrow {
        margin: 0 0 var(--lui-spacing-fixed-8, 8px);
        font-size: 0.6875rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        opacity: 0.5;
      }

      .hero__title {
        margin: 0 0 var(--lui-spacing-fixed-16, 16px);
        font-size: clamp(1.75rem, 1rem + 3vw, 3rem);
        line-height: 1.1;
        letter-spacing: -0.02em;
      }

      .hero__lead {
        margin: 0;
        max-width: 46ch;
        line-height: 1.6;
        opacity: 0.75;
      }

      .hero__aside {
        display: flex;
        align-items: flex-end;
      }

      .spec {
        margin: 0;
        width: 100%;
        font-family: ui-monospace, monospace;
        font-size: 0.75rem;
      }

      .spec__row {
        display: flex;
        justify-content: space-between;
        gap: var(--lui-spacing-fixed-8, 8px);
        padding-block: 6px;
        border-bottom: 1px solid var(--lui-color-neutral-border-subtle, #eee);
      }

      .spec dt {
        font-weight: 700;
      }

      .spec dd {
        margin: 0;
        opacity: 0.6;
      }

      /* ── Stats ───────────────────────────────────────────────── */
      .stat {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: var(--lui-spacing-fixed-16, 16px);
        border-radius: var(--lui-border-radius-md, 8px);
        background: var(--lui-color-neutral-background-container, #f4f4f4);
      }

      .stat__value {
        font-size: 1.125rem;
        font-family: ui-monospace, monospace;
      }

      .stat__label {
        font-size: 0.75rem;
        opacity: 0.6;
      }

      /* ── Faixa full-bleed ────────────────────────────────────── */
      .band {
        background: var(--lui-color-neutral-background-container, #f4f4f4);
      }

      .nested {
        padding: var(--lui-spacing-fixed-16, 16px);
        border-radius: var(--lui-border-radius-sm, 4px);
        background: var(--lui-color-neutral-background-surface, #fff);
        font-family: ui-monospace, monospace;
        font-size: 0.75rem;
      }

      /* ── Cards ───────────────────────────────────────────────── */
      .card {
        display: flex;
        flex-direction: column;
        gap: var(--lui-spacing-fixed-8, 8px);
        padding: var(--lui-spacing-fixed-16, 16px);
        border-radius: var(--lui-border-radius-md, 8px);
        border: 1px solid var(--lui-color-neutral-border-subtle, #e6e6e6);
      }

      .card__tag {
        font-size: 0.6875rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        opacity: 0.5;
      }

      .card__title {
        margin: 0;
        font-size: 1rem;
      }

      .card__excerpt {
        margin: 0;
        font-size: 0.875rem;
        line-height: 1.55;
        opacity: 0.7;
      }

      /* ── Artigo + trilho ─────────────────────────────────────── */
      .prose p {
        margin: 0 0 var(--lui-spacing-fixed-16, 16px);
        max-width: 68ch;
        line-height: 1.7;
        opacity: 0.8;
      }

      .rail {
        padding: var(--lui-spacing-fixed-16, 16px);
        border-radius: var(--lui-border-radius-md, 8px);
        background: var(--lui-color-neutral-background-container, #f4f4f4);
        align-self: start;
      }

      .rail__title {
        margin: 0 0 var(--lui-spacing-fixed-8, 8px);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        opacity: 0.6;
      }

      .rail__list {
        margin: 0;
        padding-left: 1.1em;
        font-size: 0.875rem;
        line-height: 1.8;
        opacity: 0.75;
      }

      /* ── Web Components ──────────────────────────────────────── */
      .wc {
        padding: var(--lui-spacing-fixed-16, 16px);
        border-radius: var(--lui-border-radius-sm, 4px);
        background: var(--lui-color-primary-background-surface, #e8f2ff);
        font-family: ui-monospace, monospace;
        font-size: 0.75rem;
        text-align: center;
      }

      /* ── Footer ──────────────────────────────────────────────── */
      .site-footer {
        border-top: 1px solid var(--lui-color-neutral-border-subtle, #e6e6e6);
        font-size: 0.875rem;
        opacity: 0.7;
      }

      .site-footer__right {
        text-align: right;
      }

      .site-footer a {
        color: inherit;
      }
    </style>
  </body>
</html>
