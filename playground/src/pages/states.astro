---
import '@lets-ui/tokens';
import '@lets-ui/styles';
import 'lets-ui-icons/dist/lets-ui-icons.css';
---

<!doctype html>
<html lang="pt-BR" data-theme="light" data-brand="lets-ui">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>State Layer — Let's UI Playground</title>
    <style>
      body {
        margin: 0;
        padding: 96px 24px 64px;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        background: var(--lui-color-neutral-background-surface);
        color: var(--lui-color-neutral-text-body);
      }

      /* ── Toolbar ─────────────────────────────────────────── */
      .toolbar {
        position: fixed;
        inset: 0 0 auto;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        padding: 12px 24px;
        background: var(--lui-color-neutral-background-surface);
        border-bottom: 1px solid var(--lui-color-neutral-border-subtle);
      }

      .toolbar__group {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .toolbar__label {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        opacity: 0.5;
      }

      .segment {
        display: flex;
        border: 1px solid var(--lui-color-neutral-border-default);
        border-radius: 8px;
        overflow: hidden;
      }

      .segment__btn {
        padding: 6px 14px;
        font: inherit;
        font-size: 13px;
        font-weight: 500;
        background: transparent;
        color: var(--lui-color-neutral-text-body);
        border: none;
        border-right: 1px solid var(--lui-color-neutral-border-default);
        cursor: pointer;
      }

      .segment__btn:last-child {
        border-right: none;
      }

      .segment__btn[aria-pressed='true'] {
        background: var(--lui-color-neutral-background-overlay);
        color: var(--lui-color-neutral-text-inverse);
      }

      /* ── Page scaffold ───────────────────────────────────── */
      .page {
        display: flex;
        flex-direction: column;
        gap: 48px;
        max-width: 960px;
        margin: 0 auto;
      }

      .intro h1 {
        margin: 0 0 8px;
        font-size: 22px;
      }

      .intro p {
        margin: 0;
        max-width: 68ch;
        line-height: 1.6;
        opacity: 0.75;
      }

      .section {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .section__title {
        margin: 0;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        opacity: 0.5;
      }

      .section__note {
        margin: -8px 0 0;
        font-size: 13px;
        line-height: 1.5;
        opacity: 0.6;
      }

      .row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px;
      }

      .col {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .panel {
        padding: 16px;
        border: 1px solid var(--lui-color-neutral-border-subtle);
        border-radius: 12px;
        background: var(--lui-color-neutral-background-surface);
      }

      /* ── Token readout ───────────────────────────────────── */
      .swatches {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
      }

      .swatch {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        border: 1px solid var(--lui-color-neutral-border-subtle);
        border-radius: 12px;
        min-width: 260px;
      }

      .swatch__chip {
        width: 44px;
        height: 44px;
        border-radius: 8px;
        border: 1px solid var(--lui-color-neutral-border-subtle);
        /* The same expression the components use: the element's own content
           colour mixed into its own background. Each swatch below sets that
           pair, so the chips move in opposite directions from one rule. */
        background-color: color-mix(
          in srgb,
          currentcolor var(--swatch-amount, 0%),
          var(--swatch-bg, var(--lui-color-neutral-background-surface))
        );
      }

      .swatch--on-light {
        color: var(--lui-color-neutral-text-body);
        --swatch-bg: var(--lui-color-neutral-background-surface);
      }

      .swatch--on-dark {
        color: var(--lui-color-neutral-text-inverse);
        --swatch-bg: var(--lui-color-neutral-background-overlay);
        background: var(--lui-color-neutral-background-overlay);
      }

      .swatch--on-dark .swatch__name,
      .swatch--on-dark .swatch__value {
        color: var(--lui-color-neutral-text-inverse);
      }

      /* ── Direction lanes ─────────────────────────────────── */
      .lane {
        display: grid;
        grid-template-columns: 210px 1fr;
        align-items: center;
        gap: 16px;
        padding: 14px 0;
        border-top: 1px solid var(--lui-color-neutral-border-subtle);
      }

      .lane__meta {
        display: flex;
        flex-direction: column;
        gap: 2px;
      }

      .lane__name {
        font-size: 13px;
        font-weight: 600;
      }

      .lane__spec {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 11px;
        opacity: 0.6;
      }

      /* The lanes ride on a real variant so they get the real state rules, and
         only swap the resting colour on top of it. Doubled class to outrank the
         variant's own `button.btn--neutral` (0,1,1). */

      /* A near-black filled button: the case the old fixed tint could not
         serve — 8% black over it is imperceptible. */
      .btn.btn--ink {
        --lui-bg: #14141a;

        color: #fff;
      }

      /* The previous model, kept as a control: a black tint pinned by hand. */
      .btn.btn--legacy-tint {
        --lui-state-tint: #000;
      }

      /* A transparent, dark-on-light action in the very same theme. */
      .btn.btn--ghost {
        --lui-bg: transparent;

        color: var(--lui-color-neutral-text-body);
        border: 1px solid var(--lui-color-neutral-border-default);
      }

      .swatch__name {
        font-size: 13px;
        font-weight: 600;
      }

      .swatch__value {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 12px;
        opacity: 0.65;
      }

      /* ── Forced-state simulation ─────────────────────────── */
      /* Every component mixes the same tint into its own `--lui-bg`, so the
         playground can pin a state without hovering by repeating that mix. */
      [data-force] .force-scope
        :is(
          .btn,
          .icon-button,
          .close-button,
          .tab,
          .menu-item,
          .navbar-section a,
          .lane .btn,
          .checkbox input:checked,
          .radio input:checked,
          .switch input:checked
        ):not(:disabled, [aria-disabled='true']) {
        background-color: color-mix(
          in srgb,
          var(--lui-state-tint, currentcolor) var(--forced-amount),
          var(--lui-bg, transparent)
        );
      }

      /* Spelled out on purpose: the amounts are not tokens, they are constants
         of the interaction model declared in _functions.scss. */
      [data-force='hover'] {
        --forced-amount: 8%;
      }

      [data-force='active'] {
        --forced-amount: 16%;
      }


      /* ── Timing comparison ───────────────────────────────── */
      /* Timing is two custom properties, so swapping a row's profile is just
         overriding them. Specificity 0,4,0 to beat the mixin rule (0,3,1). */
      .tt-row {
        display: grid;
        grid-template-columns: 190px 1fr;
        align-items: center;
        gap: 16px;
        padding: 10px 0;
        border-top: 1px solid var(--lui-color-neutral-border-subtle);
      }

      .tt-row__meta {
        display: flex;
        flex-direction: column;
        gap: 2px;
      }

      .tt-row__name {
        font-size: 13px;
        font-weight: 600;
      }

      .tt-row__spec {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 11px;
        opacity: 0.6;
      }

      .tt-row .btn[data-tt='a'] { --lui-state-duration: 220ms; }
      .tt-row .btn[data-tt='a']:hover {
        --lui-state-duration: 140ms;
        --lui-state-easing: ease-out;
      }
      .tt-row .btn[data-tt='a']:active {
        --lui-state-duration: 40ms;
        --lui-state-easing: linear;
      }

      .tt-row .btn[data-tt='b'] { --lui-state-duration: 320ms; }
      .tt-row .btn[data-tt='b']:hover {
        --lui-state-duration: 240ms;
        --lui-state-easing: cubic-bezier(0.4, 0, 0.2, 1);
      }
      .tt-row .btn[data-tt='b']:active {
        --lui-state-duration: 90ms;
        --lui-state-easing: linear;
      }

      .tt-row .btn[data-tt='c'] { --lui-state-duration: 420ms; }
      .tt-row .btn[data-tt='c']:hover {
        --lui-state-duration: 320ms;
        --lui-state-easing: linear;
      }
      .tt-row .btn[data-tt='c']:active {
        --lui-state-duration: 120ms;
        --lui-state-easing: linear;
      }

      .tt-row .btn[data-tt='d'] { --lui-state-duration: 600ms; }
      .tt-row .btn[data-tt='d']:hover {
        --lui-state-duration: 450ms;
        --lui-state-easing: ease-in-out;
      }
      .tt-row .btn[data-tt='d']:active {
        --lui-state-duration: 180ms;
        --lui-state-easing: linear;
      }

      /* ── Demo-only overrides ─────────────────────────────── */
      /* The real navbar is fixed and hidden under 1280px; unpin it so the
         section links can be inspected inline. */
      .navbar-demo .navbar {
        display: block;
        position: static;
        width: 260px;
        min-width: 260px;
        max-width: 260px;
        height: auto;
        border-right: none;
      }

      .navbar-demo .navbar-section ul {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin: 0;
        padding: 0;
      }

      .menu-demo {
        width: 260px;
        list-style: none;
        margin: 0;
        padding: 8px;
        border: 1px solid var(--lui-color-neutral-border-subtle);
        border-radius: 12px;
      }
    </style>
  </head>

  <body>
    <header class="toolbar">
      <div class="toolbar__group">
        <span class="toolbar__label">Tema</span>
        <div class="segment" role="group" aria-label="Tema">
          <button class="segment__btn" data-theme-value="light" aria-pressed="true">Light</button>
          <button class="segment__btn" data-theme-value="dark" aria-pressed="false">Dark</button>
          <button class="segment__btn" data-theme-value="system" aria-pressed="false">System</button>
        </div>
      </div>

      <div class="toolbar__group">
        <span class="toolbar__label">Estado forçado</span>
        <div class="segment" role="group" aria-label="Estado forçado">
          <button class="segment__btn" data-force-value="none" aria-pressed="true">Rest</button>
          <button class="segment__btn" data-force-value="hover" aria-pressed="false">Hover 8%</button>
          <button class="segment__btn" data-force-value="active" aria-pressed="false">Active 16%</button>
        </div>
      </div>
    </header>

    <main class="page">
      <section class="intro">
        <h1>State layer</h1>
        <p>
          Hover e active são uma camada translúcida misturada ao fundo de
          repouso do próprio componente. A tinta dessa camada é a
          <strong>cor de conteúdo do componente</strong> —
          <code>currentColor</code>, a on-color do seu background — e não mais
          uma tinta preta ou branca escolhida por tema. Como conteúdo e fundo já
          são obrigados a ter contraste entre si, a camada clareia o que é
          escuro e escurece o que é claro sozinha, sem medir luminância e sem
          precisar saber sobre que superfície um componente transparente está.
          Use o seletor <strong>Estado forçado</strong> para fixar o estado sem
          passar o mouse (funciona nos componentes de CSS global) e o seletor de
          <strong>Tema</strong> para conferir os dois temas.
        </p>
      </section>

      <!-- ── Modelo ─────────────────────────────────────────── -->
      <section class="section">
        <h2 class="section__title">Modelo</h2>
        <p class="section__note">
          Nenhum token. A tinta é <code>currentColor</code>, que o componente já
          declarava ao lado do próprio fundo, e as quantidades (8% e 16%) não
          variam por tema nem por marca — são constantes SCSS em
          <code>_functions.scss</code>. O token
          <code>--lui-color-interaction-tint</code> foi removido junto com os 10
          tokens de <code>background.hover</code> /
          <code>background.pressed</code> que ele já havia substituído.
        </p>
        <div class="swatches">
          <div class="swatch swatch--on-light">
            <span class="swatch__chip" style="--swatch-amount: 8%;"></span>
            <span class="col" style="gap: 2px;">
              <span class="swatch__name">hover sobre claro</span>
              <span class="swatch__value">texto escuro 8% → escurece</span>
            </span>
          </div>
          <div class="swatch swatch--on-light">
            <span class="swatch__chip" style="--swatch-amount: 16%;"></span>
            <span class="col" style="gap: 2px;">
              <span class="swatch__name">pressed sobre claro</span>
              <span class="swatch__value">texto escuro 16% → escurece</span>
            </span>
          </div>
          <div class="swatch swatch--on-dark">
            <span class="swatch__chip" style="--swatch-amount: 8%;"></span>
            <span class="col" style="gap: 2px;">
              <span class="swatch__name">hover sobre escuro</span>
              <span class="swatch__value">texto claro 8% → clareia</span>
            </span>
          </div>
          <div class="swatch swatch--on-dark">
            <span class="swatch__chip" style="--swatch-amount: 16%;"></span>
            <span class="col" style="gap: 2px;">
              <span class="swatch__name">pressed sobre escuro</span>
              <span class="swatch__value">texto claro 16% → clareia</span>
            </span>
          </div>
        </div>
      </section>

      <div class="force-scope col" style="gap: 48px;">
        <!-- ── Direction ────────────────────────────────────── -->
        <section class="section">
          <h2 class="section__title">Direção automática</h2>
          <p class="section__note">
            Os três casos que nenhuma tinta fixa por tema atende ao mesmo tempo.
            Todos estão no mesmo tema: mantenha o seletor em <strong>Light</strong>
            e passe o mouse.
          </p>
          <div>
            <div class="lane">
              <span class="lane__meta">
                <span class="lane__name">Fundo quase preto</span>
                <span class="lane__spec">tinta = texto branco → clareia</span>
              </span>
              <span class="row">
                <button class="btn btn--neutral btn--lg btn--ink">Ação primária</button>
              </span>
            </div>

            <div class="lane">
              <span class="lane__meta">
                <span class="lane__name">O mesmo, tinta preta fixa</span>
                <span class="lane__spec">--lui-state-tint: #000 → invisível</span>
              </span>
              <span class="row">
                <button class="btn btn--neutral btn--lg btn--ink btn--legacy-tint">
                  Ação primária
                </button>
              </span>
            </div>

            <div class="lane">
              <span class="lane__meta">
                <span class="lane__name">Fundo transparente</span>
                <span class="lane__spec">tinta = texto escuro → escurece</span>
              </span>
              <span class="row">
                <button class="btn btn--neutral btn--lg btn--ghost">Ação secundária</button>
              </span>
            </div>
          </div>
        </section>

        <!-- ── Button ───────────────────────────────────────── -->
        <section class="section">
          <h2 class="section__title">Button — CSS global</h2>
          <div class="row">
            <button class="btn btn--primary btn--lg">Primary</button>
            <button class="btn btn--secondary btn--lg">Secondary</button>
            <button class="btn btn--neutral btn--lg">Neutral</button>
            <button class="btn btn--danger btn--lg">Danger</button>
            <button class="btn btn--success btn--lg">Success</button>
          </div>
          <div class="row">
            <button class="btn btn--primary btn--md">Primary</button>
            <button class="btn btn--secondary btn--md">Secondary</button>
            <button class="btn btn--neutral btn--md">Neutral</button>
            <button class="btn btn--danger btn--md">Danger</button>
            <button class="btn btn--success btn--md">Success</button>
            <button class="btn btn--primary btn--md" disabled>Disabled</button>
          </div>
        </section>

        <!-- ── Icon button / Close button ───────────────────── -->
        <section class="section">
          <h2 class="section__title">Icon button · Close button</h2>
          <div class="row">
            <button class="icon-button icon-button--lg" aria-label="Editar">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>
            </button>
            <button class="icon-button icon-button--md" aria-label="Editar">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>
            </button>
            <button class="close-button close-button--lg" aria-label="Fechar">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m18 6-12 12M6 6l12 12"></path></svg>
            </button>
            <button class="close-button close-button--md" aria-label="Fechar">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m18 6-12 12M6 6l12 12"></path></svg>
            </button>
            <button class="close-button close-button--sm" aria-label="Fechar">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m18 6-12 12M6 6l12 12"></path></svg>
            </button>
          </div>
        </section>

        <!-- ── Tabs ─────────────────────────────────────────── -->
        <section class="section">
          <h2 class="section__title">Tabs</h2>
          <p class="section__note">
            A mesma camada cobre aba selecionada e não selecionada, nos dois
            variants — antes eram oito regras de background concorrendo por
            especificidade.
          </p>
          <div class="col">
            <div class="tabs tabs--line" style="max-width: 480px;">
              <div class="tabs__list" role="tablist">
                <button class="tab" role="tab" aria-selected="true">Visão geral</button>
                <button class="tab" role="tab" aria-selected="false">Configurações</button>
                <button class="tab" role="tab" aria-selected="false">Histórico</button>
                <button class="tab" role="tab" aria-selected="false" disabled>Desabilitada</button>
              </div>
            </div>

            <div class="tabs tabs--card" style="max-width: 480px;">
              <div class="tabs__list" role="tablist">
                <button class="tab" role="tab" aria-selected="true">Visão geral</button>
                <button class="tab" role="tab" aria-selected="false">Configurações</button>
                <button class="tab" role="tab" aria-selected="false">Histórico</button>
                <button class="tab" role="tab" aria-selected="false" disabled>Desabilitada</button>
              </div>
            </div>
          </div>
        </section>

        <!-- ── Menu item ────────────────────────────────────── -->
        <section class="section">
          <h2 class="section__title">Menu item · Navbar</h2>
          <div class="row" style="align-items: flex-start; gap: 32px;">
            <ul class="menu-demo">
              <li><button class="menu-item"><span class="menu-item__label">Renomear</span></button></li>
              <li><button class="menu-item"><span class="menu-item__label">Duplicar</span></button></li>
              <li><button class="menu-item"><span class="menu-item__label">Compartilhar</span></button></li>
              <li><button class="menu-item" disabled><span class="menu-item__label">Arquivar</span></button></li>
            </ul>

            <div class="navbar-demo">
              <nav class="navbar">
                <div class="navbar-section">
                  <h6>Componentes</h6>
                  <ul>
                    <li><a href="#">Button</a></li>
                    <li><a href="#">Tabs</a></li>
                    <li><a href="#">Dropdown menu</a></li>
                  </ul>
                </div>
              </nav>
            </div>
          </div>
        </section>

        <!-- ── Selection controls ───────────────────────────── -->
        <section class="section">
          <h2 class="section__title">Checkbox · Radio · Switch</h2>
          <p class="section__note">
            A camada só se aplica ao controle marcado, que é quem tem background
            preenchido.
          </p>
          <div class="row" style="gap: 24px;">
            <label class="checkbox checkbox--lg">
              <input type="checkbox" checked />
              <span>Marcado</span>
            </label>
            <label class="checkbox checkbox--lg">
              <input type="checkbox" />
              <span>Desmarcado</span>
            </label>
            <label class="radio radio--lg">
              <input type="radio" name="pg-radio" checked />
              <span>Marcado</span>
            </label>
            <label class="radio radio--lg">
              <input type="radio" name="pg-radio" />
              <span>Desmarcado</span>
            </label>
            <label class="switch switch--lg">
              <input type="checkbox" checked />
              <span>Ligado</span>
            </label>
          </div>
        </section>
      </div>

      <!-- ── Timing comparison ──────────────────────────────── -->
      <section class="section">
        <h2 class="section__title">Comparador de timing</h2>
        <p class="section__note">
          Mesma camada, quatro ritmos. Passe o cursor devagar em cada botão e
          depois clique e segure. O perfil A é o que está aplicado hoje.
        </p>
        <div>
          {[
            ['a', 'A — atual', '140ms ease-out · press 40ms · saída 220ms'],
            ['b', 'B — médio', '240ms standard · press 90ms · saída 320ms'],
            ['c', 'C — longo', '320ms linear · press 120ms · saída 420ms'],
            ['d', 'D — muito longo', '450ms ease-in-out · press 180ms · saída 600ms'],
          ].map(([key, name, spec]) => (
            <div class="tt-row">
              <span class="tt-row__meta">
                <span class="tt-row__name">{name}</span>
                <span class="tt-row__spec">{spec}</span>
              </span>
              <span class="row">
                <button class="btn btn--primary btn--lg" data-tt={key}>Primary</button>
                <button class="btn btn--neutral btn--lg" data-tt={key}>Neutral</button>
                <button class="btn btn--danger btn--md" data-tt={key}>Danger</button>
              </span>
            </div>
          ))}
        </div>
      </section>

      <!-- ── Web components ─────────────────────────────────── -->
      <section class="section">
        <h2 class="section__title">Web components (shadow DOM)</h2>
        <p class="section__note">
          O CSS global não atravessa o shadow root, então o estado forçado não
          alcança estes — passe o mouse e clique para conferir que a camada é a
          mesma.
        </p>
        <div class="panel col" style="gap: 20px;">
          <div class="row">
            <lui-button variant="primary" size="lg" label="Primary"></lui-button>
            <lui-button variant="secondary" size="lg" label="Secondary"></lui-button>
