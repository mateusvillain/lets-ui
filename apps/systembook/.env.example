# Environment for the SystemBook instance. Copy to `.env` (git-ignored) and
# fill in the four required values before the first `docker compose up`.
#
#   cp .env.example .env
#
# Generate each secret with a strong random value: openssl rand -base64 32

# --- Required ---

# Signs the session cookies. Changing it invalidates every open session.
SESSION_SECRET=

# Pepper mixed into the argon2id password hash. Do NOT change it after users
# exist — every stored password would stop matching.
ARGON2_SECRET=

# Bootstrap admin, created on the first boot against an empty database. Rotate
# the password from the admin panel right after the first login, then drop
# INITIAL_ADMIN_PASSWORD from this file.
INITIAL_ADMIN_EMAIL=admin@lets-ui.com
INITIAL_ADMIN_PASSWORD=

# --- Local development only ---

# The image runs as NODE_ENV=production, which marks the session cookie
# `Secure`. Safari refuses a Secure cookie over http://localhost and the login
# silently fails there; Chrome and Firefox accept it. Uncomment for a local
# instance — in the server this variable is read for nothing else.
#
# NEVER set it on the real deployment: it would strip `Secure` from the session
# cookie on the public domain.
# NODE_ENV=development

# --- Optional (the image already defaults these) ---

# HTTP port (default 3000).
# PORT=3000

# SQLite file. Keep it under /app/data so it stays on the persistent volume.
# DATABASE_PATH=/app/data/systembook.db

# Uploaded preview artifacts (default /app/data/previews, on the volume).
# PREVIEWS_PATH=/app/data/previews
