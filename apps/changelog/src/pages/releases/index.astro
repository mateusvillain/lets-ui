---
/**
 * Every release as a plain list: the no-JavaScript route to the full
 * history, and a compact index for anyone looking for one version.
 */
import Base from '@/layouts/Base.astro';
import { TYPE_LABELS } from '@/lib/changelog.js';
import { loadReleases } from '@/lib/releases.js';
import { longDate, shortDate } from '@/lib/format.js';
import { inlineText } from '@/lib/markdown.js';

const releases = loadReleases();
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Base
  title="All releases · Let's UI changelog"
  description="Every Let's UI release, from CHANGELOG.md."
>
  <main id="content" tabindex="-1" class="container notes-page">
    <a class="back-link" href={base}>
      <svg class="icon" width="14" height="14" aria-hidden="true" focusable="false"><use href="#icon-arrow-left" /></svg>
      Timeline
    </a>

    <h1 class="notes__title">All releases</h1>

    <ol class="archive" role="list">
      {releases.map((release) => (
        <li class="archive__item">
          <a class="archive__link" href={`${base}releases/${release.slug}/`}>
            <span class="archive__version">{release.tag}</span>
            <span class="archive__title" set:html={inlineText(release.title)} />
          </a>
          <span class="archive__meta">
            {release.type && <span class={`tag tag--${release.type}`}>{TYPE_LABELS[release.type]}</span>}
            {release.date && (
              <time datetime={release.date}>
                <span aria-hidden="true">{shortDate(release.date)}</span>
                <span class="visually-hidden">{longDate(release.date)}</span>
              </time>
            )}
          </span>
        </li>
      ))}
    </ol>
  </main>
</Base>
