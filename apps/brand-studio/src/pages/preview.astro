---
/**
 * Página renderizada dentro do iframe do studio.
 *
 * Vive isolada de propósito: o studio sobrescreve as custom properties
 * `--lui-brand-*` no `:root` deste documento, e como os tokens semânticos são
 * `var()` para os tokens de marca, tudo aqui reage — sem contaminar a interface
 * de edição, que roda com a marca padrão no documento de fora.
 *
 * O corpo são duas cenas mutuamente exclusivas, trocadas pelo `data-scene` do
 * `:root` — o mesmo canal por onde já entram tema e overlay de grid:
 *
 *   landing  página de marketing: a marca em composição real, sobre a grade da
 *            própria marca, com a escala tipográfica inteira em uso.
 *   tokens   folha de espécime: as rampas de cor com hex, os raios e a régua de
 *            colunas, para leitura direta de valor quando a composição não
 *            responde a pergunta.
 *
 * As duas ficam no DOM o tempo todo — o CSS só mostra a ativa — porque a régua
 * de grid e os rótulos de hex são atualizados por consulta ao documento inteiro.
 */
import '@lets-ui/tokens';
import '@lets-ui/styles';

const FAMILIES = ['primary', 'secondary'];
const STEPS = [1, 2, 3, 4, 5, 6, 7, 8];
const RADII = ['xs', 'sm', 'md', 'lg', 'xl'];
const HEADINGS = [
  ['display', 'Display'],
  ['title', 'Title'],
  ['subtitle', 'Subtitle'],
  ['headline', 'Headline'],
  ['subheadline', 'Subheadline'],
  ['block-title', 'Block title'],
  ['overtitle', 'Overtitle'],
];

/* Ícones do próprio design system, usados como conteúdo da landing. */
const ICONS = {
  grid: 'M5.625 17.25C6.24632 17.25 6.75 17.7537 6.75 18.375C6.75 18.9963 6.24632 19.5 5.625 19.5C5.00368 19.5 4.5 18.9963 4.5 18.375C4.5 17.7537 5.00368 17.25 5.625 17.25ZM12 17.25C12.6213 17.25 13.125 17.7537 13.125 18.375C13.125 18.9963 12.6213 19.5 12 19.5C11.3787 19.5 10.875 18.9963 10.875 18.375C10.875 17.7537 11.3787 17.25 12 17.25ZM18.375 17.25C18.9963 17.25 19.5 17.7537 19.5 18.375C19.5 18.9963 18.9963 19.5 18.375 19.5C17.7537 19.5 17.25 18.9963 17.25 18.375C17.25 17.7537 17.7537 17.25 18.375 17.25ZM5.625 10.875C6.24632 10.875 6.75 11.3787 6.75 12C6.75 12.6213 6.24632 13.125 5.625 13.125C5.00368 13.125 4.5 12.6213 4.5 12C4.5 11.3787 5.00368 10.875 5.625 10.875ZM12 10.875C12.6213 10.875 13.125 11.3787 13.125 12C13.125 12.6213 12.6213 13.125 12 13.125C11.3787 13.125 10.875 12.6213 10.875 12C10.875 11.3787 11.3787 10.875 12 10.875ZM18.375 10.875C18.9963 10.875 19.5 11.3787 19.5 12C19.5 12.6213 18.9963 13.125 18.375 13.125C17.7537 13.125 17.25 12.6213 17.25 12C17.25 11.3787 17.7537 10.875 18.375 10.875ZM5.625 4.5C6.24632 4.5 6.75 5.00368 6.75 5.625C6.75 6.24632 6.24632 6.75 5.625 6.75C5.00368 6.75 4.5 6.24632 4.5 5.625C4.5 5.00368 5.00368 4.5 5.625 4.5ZM12 4.5C12.6213 4.5 13.125 5.00368 13.125 5.625C13.125 6.24632 12.6213 6.75 12 6.75C11.3787 6.75 10.875 6.24632 10.875 5.625C10.875 5.00368 11.3787 4.5 12 4.5ZM18.375 4.5C18.9963 4.5 19.5 5.00368 19.5 5.625C19.5 6.24632 18.9963 6.75 18.375 6.75C17.7537 6.75 17.25 6.24632 17.25 5.625C17.25 5.00368 17.7537 4.5 18.375 4.5Z',
  check:
    'M12 3C16.9706 3 21 7.02944 21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3ZM12 4.5C7.85786 4.5 4.5 7.85786 4.5 12C4.5 16.1421 7.85786 19.5 12 19.5C16.1421 19.5 19.5 16.1421 19.5 12C19.5 7.85786 16.1421 4.5 12 4.5ZM15.9697 8.46973C16.2626 8.17684 16.7374 8.17684 17.0303 8.46973C17.3232 8.76262 17.3232 9.23738 17.0303 9.53027L11.0303 15.5303C10.7374 15.8232 10.2626 15.8232 9.96973 15.5303L6.96973 12.5303C6.67683 12.2374 6.67683 11.7626 6.96973 11.4697C7.26262 11.1768 7.73738 11.1768 8.03027 11.4697L10.5 13.9395L15.9697 8.46973Z',
  info: 'M12 3C16.9706 3 21 7.02944 21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3ZM12 4.5C7.85786 4.5 4.5 7.85786 4.5 12C4.5 16.1421 7.85786 19.5 12 19.5C16.1421 19.5 19.5 16.1421 19.5 12C19.5 7.85786 16.1421 4.5 12 4.5ZM12.75 15H13.5C13.9142 15 14.25 15.3358 14.25 15.75C14.25 16.1642 13.9142 16.5 13.5 16.5H10.5C10.0858 16.5 9.75 16.1642 9.75 15.75C9.75 15.3358 10.0858 15 10.5 15H11.25V12H10.5C10.0858 12 9.75 11.6642 9.75 11.25C9.75 10.8358 10.0858 10.5 10.5 10.5H12.75V15ZM11.8125 7.5C12.3303 7.5 12.75 7.91973 12.75 8.4375C12.75 8.95527 12.3303 9.375 11.8125 9.375C11.2947 9.375 10.875 8.95527 10.875 8.4375C10.875 7.91973 11.2947 7.5 11.8125 7.5Z',
};

const NAV_LINKS = ['Produto', 'Preços', 'Documentação', 'Changelog'];

const FEATURES = [
  {
    icon: ICONS.grid,
    title: 'Tokens em DTCG',
    body: 'Cor, tipografia, espaçamento e grade em arquivos versionados, compilados para CSS e SCSS.',
  },
  {
    icon: ICONS.check,
    title: 'Contraste verificado',
    body: 'Cada par de texto e fundo é medido contra a WCAG antes de a marca ir para produção.',
  },
  {
    icon: ICONS.info,
    title: 'Claro e escuro por padrão',
    body: 'Um mesmo conjunto de papéis semânticos resolve nos dois temas sem componente duplicado.',
  },
];

const METRICS = [
  ['312', 'tokens publicados'],
  ['44', 'componentes'],
  ['2', 'temas por marca'],
  ['0', 'valores fixos no CSS'],
];

const PLANS = [
  {
    name: 'Individual',
    price: 'R$ 0',
    note: 'para sempre',
    featured: false,
    items: ['1 marca', 'Tema claro e escuro', 'Exportação DTCG'],
    action: 'Começar',
    variant: 'secondary',
  },
  {
    name: 'Time',
    price: 'R$ 89',
    note: 'por editor / mês',
    featured: true,
    items: [
      'Marcas ilimitadas',
      'Revisão de contraste',
      'Histórico de publicação',
      'Integração com o repositório',
    ],
    action: 'Testar 14 dias',
    variant: 'primary',
  },
  {
    name: 'Organização',
    price: 'Sob consulta',
    note: 'faturamento anual',
    featured: false,
    items: ['SSO e auditoria', 'Ambientes isolados', 'Suporte dedicado'],
    action: 'Falar com vendas',
    variant: 'secondary',
  },
];

const FOOTER = [
  ['Produto', ['Visão geral', 'Preços', 'Changelog', 'Status']],
  ['Recursos', ['Documentação', 'Guia de marca', 'Exemplos', 'API']],
  ['Empresa', ['Sobre', 'Blog', 'Carreiras', 'Contato']],
];
---

<!doctype html>
<html lang="pt-BR" data-brand="lets-ui" data-theme="light" data-scene="landing">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Preview — Brand Studio</title>
  </head>
  <body>
    <!--
      Régua de colunas sobre o conteúdo: o studio a liga enquanto a aba Grid
      está aberta, para que colunas, gutter e margem sejam avaliados sobre a
      página real e não sobre um exemplo isolado.
    -->
    <div class="pv-overlay" aria-hidden="true">
      <div class="pv-overlay__grid" data-overlay></div>
      <p class="pv-overlay__readout" data-grid-note></p>
    </div>

    <!-- ══ Cena: landing ═══════════════════════════════════════ -->
    <div class="pv-scene" data-scene="landing">
      <header class="pv-topbar">
        <div class="pv-topbar__inner">
          <a class="pv-brandmark" href="#">
            <span class="pv-brandmark__mark" aria-hidden="true"></span>
            <span class="pv-brandmark__name" data-brand-label>Let's UI</span>
          </a>

          <nav class="pv-topbar__links" aria-label="Principal">
            {NAV_LINKS.map((label) => <lui-link label={label} href="#" size="sm" />)}
          </nav>

          <div class="pv-topbar__actions">
            <lui-button label="Entrar" variant="ghost" size="md"></lui-button>
            <lui-button label="Criar conta" size="md"></lui-button>
          </div>
        </div>
      </header>

      <section class="pv-hero pv-cols pv-cols--2">
        <div class="pv-hero__copy">
          <lui-tag label="Novo · exportação DTCG" variant="primary" tag-style="container" size="sm"></lui-tag>
          <lui-heading variant="display" as="h1" label="A sua marca, do token ao produto" />
          <lui-body
            variant="lg"
            label="Defina cor, tipografia e forma uma única vez. Cada componente do sistema resolve a partir daí — em qualquer marca, em qualquer tema."
          />
          <div class="pv-hero__actions">
            <lui-button label="Começar agora" size="lg"></lui-button>
            <lui-button label="Ver documentação" variant="secondary" size="lg"></lui-button>
          </div>
          <lui-body variant="sm" color="caption" label="Sem cartão de crédito · Cancele quando quiser" />
        </div>

        <!-- Maquete de produto: o fill primário em superfície grande é onde a
             troca de marca aparece primeiro. -->
        <div class="pv-mock" aria-hidden="true">
          <div class="pv-mock__bar">
            <span class="pv-mock__dot"></span>
            <span class="pv-mock__dot"></span>
            <span class="pv-mock__dot"></span>
          </div>
          <div class="pv-mock__body">
            <div class="pv-mock__side">
              <span class="pv-mock__line pv-mock__line--strong"></span>
              <span class="pv-mock__line"></span>
              <span class="pv-mock__line"></span>
              <span class="pv-mock__line"></span>
            </div>
            <div class="pv-mock__content">
              <div class="pv-mock__hero"></div>
              <div class="pv-mock__cards">
                <span class="pv-mock__card"></span>
                <span class="pv-mock__card"></span>
                <span class="pv-mock__card"></span>
              </div>
              <span class="pv-mock__line"></span>
              <span class="pv-mock__line pv-mock__line--short"></span>
            </div>
          </div>
        </div>
      </section>

      <section class="pv-band">
        <dl class="pv-band__inner pv-cols pv-cols--4">
          {
            METRICS.map(([value, label]) => (
              <div class="pv-metric">
                <dt class="pv-metric__value">{value}</dt>
                <dd class="pv-metric__label">{label}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="pv-block">
        <header class="pv-block__head">
          <lui-heading variant="overtitle" as="p" label="Por que tokens" />
          <lui-heading variant="title" as="h2" label="Um sistema que não depende de disciplina" />
          <lui-body
            variant="md"
            color="caption"
            label="Nada aqui está fixo no CSS do componente: trocar a marca é trocar os arquivos de token."
          />
        </header>

        <div class="pv-cards pv-cols pv-cols--3">
          {
            FEATURES.map((feature) => (
              <lui-card>
                <div class="pv-feature">
                  <span class="pv-feature__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d={feature.icon} /></svg>
                  </span>
                  <lui-heading variant="block-title" as="h3" label={feature.title} />
                  <lui-body variant="sm" color="caption" label={feature.body} />
                  <lui-link label="Saber mais" href="#" size="sm" />
                </div>
              </lui-card>
            ))
          }
        </div>
      </section>

      <section class="pv-block">
        <header class="pv-block__head">
          <lui-heading variant="overtitle" as="p" label="Planos" />
          <lui-heading variant="title" as="h2" label="Comece de graça, cresça quando precisar" />
        </header>

        <div class="pv-cards pv-cols pv-cols--3">
          {
            PLANS.map((plan) => (
              <div class={`pv-plan${plan.featured ? ' pv-plan--featured' : ''}`}>
                <lui-card>
                  <div class="pv-plan__body">
                    <div class="pv-plan__head">
                      <lui-heading variant="block-title" as="h3" label={plan.name} />
                      {plan.featured && <lui-tag label="Mais escolhido" variant="primary" size="sm" />}
                    </div>

                    <p class="pv-plan__price">
                      <span class="pv-plan__amount">{plan.price}</span>
                      <span class="pv-plan__note">{plan.note}</span>
                    </p>

                    <lui-divider />

                    <ul class="pv-plan__items">
                      {
                        plan.items.map((item) => (
                          <li>
                            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                              <path d={ICONS.check} />
                            </svg>
                            {item}
                          </li>
                        ))
                      }
                    </ul>
                  </div>
                  <lui-button slot="actions" label={plan.action} variant={plan.variant} block></lui-button>
                </lui-card>
              </div>
            ))
          }
        </div>
      </section>

      <section class="pv-cta">
        <div class="pv-cta__inner pv-cols pv-cols--2">
          <div class="pv-cta__copy">
            <lui-heading variant="subtitle" as="h2" label="Publique a primeira marca hoje" color="inverse" />
            <lui-body
              variant="md"
              color="inverse"
              label="Sem cartão de crédito. Exporte os arquivos e versione junto com o código."
            />
          </div>
          <form class="pv-cta__form" onsubmit="return false">
            <lui-input
              size="lg"
              name="email"
              type="email"
              aria-label="E-mail de trabalho"
              placeholder="voce@empresa.com"
            ></lui-input>
            <lui-button label="Criar conta" size="lg" variant="neutral"></lui-button>
          </form>
        </div>
      </section>

      <footer class="pv-footer">
        <div class="pv-footer__inner pv-cols pv-cols--4">
          <div class="pv-footer__brand">
            <span class="pv-brandmark__mark" aria-hidden="true"></span>
            <lui-body variant="sm" color="caption" label="Design system multimarca, aberto e sem framework." />
          </div>

          {
            FOOTER.map(([title, links]) => (
              <nav class="pv-footer__col" aria-label={title}>
                <p class="pv-footer__title">{title}</p>
                {links.map((label) => <lui-link label={label} href="#" size="sm" />)}
              </nav>
            ))
          }
        </div>

        <lui-divider />

        <p class="pv-footer__legal">
          <span data-brand-label>Let's UI</span> © 2026 · Todos os direitos reservados
        </p>
      </footer>
    </div>

    <!-- ══ Cena: tokens ════════════════════════════════════════ -->
    <div class="pv-scene" data-scene="tokens">
      <main class="pv-main">
        <!-- ── Escalas de cor ───────────────────────────────────── -->
        <section class="pv-section" id="section-color">
          <h2 class="pv-section__title">Escalas de cor</h2>
          {
            FAMILIES.map((family) => (
              <div class="pv-ramp">
                <span class="pv-ramp__label">{family}</span>
                <div class="pv-ramp__steps">
                  {STEPS.map((step) => (
                    <div class="pv-swatch">
                      <span
                        class="pv-swatch__chip"
                        style={`background: var(--lui-brand-color-${family}-${step})`}
                      ></span>
                      <span class="pv-swatch__step">{step}</span>
                      <span class="pv-swatch__hex" data-swatch={`${family}.${step}`}></span>
                    </div>
                  ))}
                </div>
              </div>
            ))
          }
        </section>

        <!-- ── Tipografia ───────────────────────────────────────── -->
        <section class="pv-section" id="section-typography">
          <h2 class="pv-section__title">Tipografia</h2>
          <div class="pv-col">
            {
              HEADINGS.map(([variant, label]) => (
                <lui-heading variant={variant} label={`${label} — Uma marca, um sistema`} />
              ))
            }
            <lui-body
              variant="md"
              label="Corpo de texto — a escala é fluida: cada degrau interpola entre um mínimo e um máximo conforme a largura da viewport."
            ></lui-body>
            <lui-body variant="sm" color="caption" label="Legenda — texto de apoio em escala menor."></lui-body>
          </div>
        </section>

        <!-- ── Forma ────────────────────────────────────────────── -->
        <section class="pv-section" id="section-shape">
          <h2 class="pv-section__title">Raio de borda</h2>
          <div class="pv-row">
            {
              RADII.map((size) => (
                <div class="pv-radius">
                  <span
                    class="pv-radius__box"
                    style={`border-radius: var(--lui-brand-border-radius-${size})`}
                  ></span>
                  <span class="pv-radius__label">{size}</span>
                </div>
              ))
            }
          </div>
        </section>

        <!-- ── Grid ─────────────────────────────────────────────── -->
        <section class="pv-section" id="section-grid">
          <h2 class="pv-section__title">Grid</h2>
          <p class="pv-note">
            Colunas, gutter e margem seguem o breakpoint ativo para a largura do preview.
          </p>
          <div class="pv-grid" data-grid></div>
        </section>
      </main>
    </div>

    <script>
      import '@lets-ui/components';

      /**
       * Os chips de cor mostram o hex resolvido. Como o valor vem de uma custom
       * property sobrescrita pelo studio, ele é lido do estilo computado a cada
       * atualização — o studio dispara `lui-brand-update` depois de aplicar.
       */
      function refreshSwatchLabels() {
        const styles = getComputedStyle(document.documentElement);

        for (const element of document.querySelectorAll('[data-swatch]')) {
          const [family, step] = element.getAttribute('data-swatch').split('.');
          const value = styles.getPropertyValue(`--lui-brand-color-${family}-${step}`).trim();
          element.textContent = toHex(value);
        }
      }

      /** `rgb(92.157% 96.863% 100%)` e `rgb(1 2 3)` -> `#rrggbb`. */
      function toHex(value) {
        if (value.startsWith('#')) return value;

        const channels = value.match(/-?[\d.]+%?/g);
        if (!channels || channels.length < 3) return value;

        return (
          '#' +
          channels
            .slice(0, 3)
            .map((channel) => {
              const number = parseFloat(channel);
              const scaled = channel.endsWith('%') ? (number / 100) * 255 : number;
              return Math.round(scaled).toString(16).padStart(2, '0');
            })
            .join('')
        );
      }

      /**
       * O nome da marca em edição chega pelo `data-brand-name` do `:root` e
       * preenche a marca-d'água da landing — é o que faz a composição parecer o
       * produto de quem está editando, e não um exemplo genérico.
       */
      function refreshBrandLabel() {
        const name = document.documentElement.dataset.brandName;
        if (!name) return;

        for (const element of document.querySelectorAll('[data-brand-label]')) {
          element.textContent = name;
        }
      }

      /** Breakpoints do maior para o menor: o primeiro que couber é o ativo. */
      const BREAKPOINTS = ['1xl', 'lg', 'md', 'sm', '1xs'];

      /**
       * Reparte `columns` entre `parts` faixas: o resto vai para as primeiras,
       * de modo que a soma seja sempre o total de colunas — é isso que faz a
       * última coluna de uma linha terminar exatamente na margem.
       */
      function distribute(columns, parts) {
        const base = Math.floor(columns / parts);
        const extra = columns % parts;
        return Array.from({ length: parts }, (_, i) => base + (i < extra ? 1 : 0));
      }

      /**
       * Quantos itens cabem por linha antes de cada um ficar estreito demais.
       * Três colunas é o piso: abaixo disso o card deixa de comportar texto e a
       * composição vira tira. Com 12 colunas cabem os três cards; com 8, dois;
       * com 4, um.
       */
      const MIN_SPAN = 3;

      function spansFor(columns, parts) {
        let perRow = parts;
        while (perRow > 1 && columns / perRow < MIN_SPAN) perRow -= 1;

        const row = distribute(columns, perRow);
        return Array.from({ length: parts }, (_, i) => row[i % perRow]);
      }

      /**
       * O grid é remontado em JS porque a quantidade de colunas é um token: uma
       * media query não consegue ler `var()`, então o breakpoint ativo é
       * resolvido aqui a partir dos próprios tokens da marca em edição — e as
       * mesmas colunas alimentam a régua e a composição, que por isso não têm
       * como sair de alinhamento uma com a outra.
       */
      function refreshGrid() {
        const root = document.documentElement;
        const styles = getComputedStyle(root);
        const read = (name) => styles.getPropertyValue(name).trim();

        // `innerWidth` inclui a barra de rolagem, como fazem as media queries —
        // `clientWidth` a desconta e faria o preview trocar de breakpoint cedo
        // demais.
        const width = window.innerWidth;
        const active =
          BREAKPOINTS.find((step) => {
            const min = parseFloat(read(`--lui-brand-grid-breakpoint-${step}`));
            return Number.isFinite(min) && width >= min;
          }) ?? '1xs';

        const columns = parseInt(read(`--lui-brand-grid-column-${active}`), 10) || 12;
        const gap = read(`--lui-brand-grid-gap-${active}`);
        const margin = read(`--lui-brand-grid-margin-${active}`) || read('--lui-brand-grid-margin-lg');

        const fill = (node, className) => {
          node.style.gridTemplateColumns = `repeat(${columns}, 1fr)`;
          node.style.gap = gap;
          node.replaceChildren(
            ...Array.from({ length: columns }, () => {
              const column = document.createElement('span');
              column.className = className;
              return column;
            })
          );
        };

        fill(document.querySelector('[data-grid]'), 'pv-grid__column');

        const overlay = document.querySelector('[data-overlay]');
        overlay.style.paddingInline = margin;
        fill(overlay, 'pv-overlay__column');

        document.querySelector('[data-grid-note]').textContent =
          `Breakpoint ativo: ${active} · ${columns} colunas · gutter ${gap} · margem ${margin}`;

        // A composição lê a grade daqui: colunas, gutter, margem e quantas
        // colunas cada item ocupa em cada padrão de repetição.
        root.style.setProperty('--pv-columns', String(columns));
        root.style.setProperty('--pv-gap', gap);
        root.style.setProperty('--pv-margin', margin);

        for (const parts of [2, 3, 4]) {
          spansFor(columns, parts).forEach((span, index) => {
            root.style.setProperty(`--pv-${parts}-${index + 1}`, String(span));
          });
        }
      }

      /* Aberto fora do studio, o preview ainda escolhe a cena pela URL:
         /preview?scene=tokens. */
      const SCENES = ['landing', 'tokens'];
      const requested = new URLSearchParams(location.search).get('scene');
      if (SCENES.includes(requested)) document.documentElement.dataset.scene = requested;

      function refresh() {
        refreshSwatchLabels();
        refreshBrandLabel();
        refreshGrid();
      }

      document.addEventListener('lui-brand-update', refresh);
      window.addEventListener('resize', refreshGrid);
      refresh();
    </script>

    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--lui-color-neutral-background-surface);
        color: var(--lui-color-neutral-text-body);
        font-family: var(--lui-brand-typography-font-family-body);
        line-height: var(--lui-brand-typography-line-height-body);
      }

      /* ── Cenas ────────────────────────────────────────────────── */

      /* As duas convivem no DOM; só a do `data-scene` do `:root` é exibida. */
      .pv-scene {
        display: none;
      }

      :root[data-scene='landing'] .pv-scene[data-scene='landing'],
      :root[data-scene='tokens'] .pv-scene[data-scene='tokens'] {
        display: block;
      }

      /* ── Grade da composição ──────────────────────────────────── */

      /* Largura útil compartilhada por todas as faixas: container e margem são
         os mesmos tokens que a régua de colunas usa, então as bordas do
         conteúdo caem sobre a primeira e a última coluna. Os valores em JS são
         a fonte; os literais aqui só valem até o primeiro `refreshGrid`. */
      .pv-topbar__inner,
      .pv-hero,
      .pv-band__inner,
      .pv-block,
      .pv-cta__inner,
      .pv-footer {
        max-width: var(--lui-brand-grid-container-1xl);
        margin: 0 auto;
        padding-inline: var(--pv-margin, var(--lui-brand-grid-margin-lg));
      }

      /* Toda faixa em colunas usa a grade da marca: o gutter é o token, nunca
         um espaçamento escolhido à parte. */
      .pv-cols {
        display: grid;
        grid-template-columns: repeat(var(--pv-columns, 12), minmax(0, 1fr));
        column-gap: var(--pv-gap, var(--lui-brand-grid-gap-lg));
        row-gap: var(--lui-spacing-fluid-32);
      }

      .pv-cols--2 > * {
        grid-column: span var(--pv-2-1, 6);
      }

      .pv-cols--2 > :nth-child(2n) {
        grid-column: span var(--pv-2-2, 6);
      }

      .pv-cols--3 > * {
        grid-column: span var(--pv-3-1, 4);
      }

      .pv-cols--3 > :nth-child(3n + 2) {
        grid-column: span var(--pv-3-2, 4);
      }

      .pv-cols--3 > :nth-child(3n) {
        grid-column: span var(--pv-3-3, 4);
      }

      .pv-cols--4 > * {
        grid-column: span var(--pv-4-1, 3);
      }

      .pv-cols--4 > :nth-child(4n + 2) {
        grid-column: span var(--pv-4-2, 3);
      }

      .pv-cols--4 > :nth-child(4n + 3) {
        grid-column: span var(--pv-4-3, 3);
      }

      .pv-cols--4 > :nth-child(4n) {
        grid-column: span var(--pv-4-4, 3);
      }

      /* ── Marca ────────────────────────────────────────────────── */

      .pv-brandmark {
        display: inline-flex;
        align-items: center;
        gap: var(--lui-spacing-fixed-8);
        color: var(--lui-color-neutral-text-heading);
        text-decoration: none;
      }

      .pv-brandmark__mark {
        width: 28px;
        height: 28px;
        flex: none;
        border-radius: var(--lui-brand-border-radius-md);
        background: var(--lui-color-primary-background-container);
      }

      .pv-brandmark__name {
        font-size: var(--lui-brand-typography-font-size-md);
        font-weight: var(--lui-typography-weight-semibold);
      }

      /* ── Landing: topo ────────────────────────────────────────── */

      .pv-topbar {
        position: sticky;
        top: 0;
        z-index: 5;
        background: var(--lui-color-neutral-background-surface);
        border-bottom: var(--lui-border-width-1) solid var(--lui-color-neutral-border-subtle);
      }

      .pv-topbar__inner {
        display: flex;
        align-items: center;
        gap: var(--lui-spacing-fluid-24);
        padding-block: var(--lui-spacing-fixed-16);
      }

      .pv-topbar__links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--lui-spacing-fluid-20);
      }

      .pv-topbar__actions {
        display: flex;
        align-items: center;
        gap: var(--lui-spacing-fixed-8);
        margin-left: auto;
      }

      /* ── Landing: hero ────────────────────────────────────────── */

      .pv-hero {
        align-items: center;
        padding-block: var(--lui-spacing-fluid-72);
      }

      .pv-hero__copy {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--lui-spacing-fluid-16);
      }

      .pv-hero__actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--lui-spacing-fixed-16);
        margin-top: var(--lui-spacing-fluid-8);
      }

      /* Maquete: só formas em tokens de cor e raio, sem texto para traduzir. */
      .pv-mock {
        border: var(--lui-border-width-1) solid var(--lui-color-neutral-border-subtle);
        border-radius: var(--lui-brand-border-radius-lg);
        background: var(--lui-color-neutral-background-container);
        overflow: hidden;
      }

      .pv-mock__bar {
        display: flex;
        gap: 6px;
        padding: var(--lui-spacing-fixed-8) var(--lui-spacing-fixed-16);
        border-bottom: var(--lui-border-width-1) solid var(--lui-color-neutral-border-subtle);
      }

      .pv-mock__dot {
        width: 8px;
        height: 8px;
        border-radius: var(--lui-border-radius-circle);
        background: var(--lui-color-neutral-border-default);
      }

      .pv-mock__body {
        display: grid;
        grid-template-columns: 72px minmax(0, 1fr);
        gap: var(--lui-spacing-fixed-16);
        padding: var(--lui-spacing-fixed-16);
      }

      .pv-mock__side,
      .pv-mock__content {
        display: flex;
        flex-direction: column;
        gap: var(--lui-spacing-fixed-8);
      }

      .pv-mock__line {
        height: 8px;
        border-radius: var(--lui-brand-border-radius-xs);
        background: var(--lui-color-neutral-border-subtle);
      }

      .pv-mock__line--strong {
        background: var(--lui-color-primary-background-container);
      }

      .pv-mock__line--short {
        width: 60%;
      }

      .pv-mock__hero {
        height: 72px;
        border-radius: var(--lui-brand-border-radius-md);
        background: var(--lui-color-primary-background-container);
      }

      .pv-mock__cards {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--lui-spacing-fixed-8);
      }

      .pv-mock__card {
        height: 40px;
        border-radius: var(--lui-brand-border-radius-sm);
        background: var(--lui-color-secondary-background-surface);
      }

      /* ── Landing: números ─────────────────────────────────────── */

      .pv-band {
        background: var(--lui-color-neutral-background-container);
        border-block: var(--lui-border-width-1) solid var(--lui-color-neutral-border-subtle);
      }

      .pv-band__inner {
        padding-block: var(--lui-spacing-fluid-40);
      }

      .pv-metric__value {
        margin: 0;
        font-size: var(--lui-brand-typography-font-size-2xl);
        font-weight: var(--lui-typography-weight-bold);
        color: var(--lui-color-primary-text-body);
      }

      .pv-metric__label {
        margin: 0;
        font-size: var(--lui-brand-typography-font-size-2xs);
        color: var(--lui-color-neutral-text-caption);
      }

      /* ── Landing: blocos ──────────────────────────────────────── */

      /* O bloco é a própria grade: o texto de abertura ocupa metade das colunas
         e a fileira de cards ocupa todas. */
      .pv-block {
        display: grid;
        grid-template-columns: repeat(var(--pv-columns, 12), minmax(0, 1fr));
        column-gap: var(--pv-gap, var(--lui-brand-grid-gap-lg));
        row-gap: var(--lui-spacing-fluid-32);
        padding-block: var(--lui-spacing-fluid-64);
      }

      .pv-block__head {
        grid-column: span var(--pv-2-1, 6);
        display: flex;
        flex-direction: column;
        gap: var(--lui-spacing-fixed-8);
      }

      .pv-cards {
        grid-column: 1 / -1;
      }

      .pv-feature {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--lui-spacing-fixed-8);
      }

      .pv-feature__icon {
        display: inline-flex;
        padding: var(--lui-spacing-fixed-8);
        margin-bottom: var(--lui-spacing-fixed-8);
        border-radius: var(--lui-brand-border-radius-md);
        background: var(--lui-color-primary-background-surface);
        color: var(--lui-color-primary-icon-default);
      }

      .pv-feature__icon svg,
      .pv-plan__items svg {
        width: 20px;
        height: 20px;
      }

      /* ── Landing: planos ──────────────────────────────────────── */

      /* O plano em destaque ganha a borda da marca — é o pedaço da página que
         mais depende de o primário funcionar contra a superfície. */
      .pv-plan--featured {
        border-radius: var(--lui-brand-border-radius-lg);
        outline: var(--lui-border-width-2) solid var(--lui-color-primary-border-default);
      }

      /* `block` no botão só estica o `<button>` dentro do host; quem precisa
         ocupar a linha de ações é o próprio host. */
      .pv-plan lui-button[slot='actions'] {
        width: 100%;
      }

      .pv-plan__body {
        display: flex;
        flex-direction: column;
        gap: var(--lui-spacing-fixed-16);
      }

      .pv-plan__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--lui-spacing-fixed-8);
      }

      .pv-plan__price {
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        gap: var(--lui-spacing-fixed-8);
        margin: 0;
      }

      .pv-plan__amount {
        font-size: var(--lui-brand-typography-font-size-1xl);
        font-weight: var(--lui-typography-weight-bold);
        color: var(--lui-color-neutral-text-heading);
      }

      .pv-plan__note {
        font-size: var(--lui-brand-typography-font-size-2xs);
        color: var(--lui-color-neutral-text-caption);
      }

      .pv-plan__items {
        display: flex;
        flex-direction: column;
        gap: var(--lui-spacing-fixed-8);
        margin: 0;
        padding: 0;
        list-style: none;
        font-size: var(--lui-brand-typography-font-size-sm);
      }

      .pv-plan__items li {
        display: flex;
        align-items: center;
        gap: var(--lui-spacing-fixed-8);
      }

      .pv-plan__items svg {
        flex: none;
        color: var(--lui-color-success-icon-default);
      }

      /* ── Landing: chamada e rodapé ────────────────────────────── */

      .pv-cta {
        background: var(--lui-color-primary-background-container);
      }

      .pv-cta__inner {
        align-items: center;
        padding-block: var(--lui-spacing-fluid-56);
      }

      .pv-cta__copy {
        display: flex;
        flex-direction: column;
        gap: var(--lui-spacing-fixed-8);
      }

      .pv-cta__form {
        display: flex;
        align-items: flex-end;
        gap: var(--lui-spacing-fixed-8);
      }

      .pv-cta__form lui-input {
        flex: 1;
      }

      .pv-footer {
        padding-block: var(--lui-spacing-fluid-56) 0;
      }

      .pv-footer__inner {
        padding-bottom: var(--lui-spacing-fluid-32);
      }

      .pv-footer__brand,
      .pv-footer__col {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--lui-spacing-fixed-8);
      }

      .pv-footer__title {
        margin: 0 0 var(--lui-spacing-fixed-8);
        font-size: var(--lui-brand-typography-font-size-2xs);
        font-weight: var(--lui-typography-weight-semibold);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--lui-color-neutral-text-caption);
      }

      /* Já está dentro do `padding-inline` do rodapé: repetir a margem aqui
         empurraria a linha para dentro do resto da faixa. */
      .pv-footer__legal {
        margin: 0;
        padding-block: var(--lui-spacing-fixed-24) var(--lui-spacing-fluid-40);
        font-size: var(--lui-brand-typography-font-size-2xs);
        color: var(--lui-color-neutral-text-caption);
      }

      /* ── Cena de tokens ───────────────────────────────────────── */

      .pv-main {
        display: flex;
        flex-direction: column;
        gap: var(--lui-spacing-fluid-56);
        max-width: var(--lui-brand-grid-container-1xl);
        margin: 0 auto;
        padding: var(--lui-spacing-fluid-48) var(--pv-margin, var(--lui-brand-grid-margin-lg));
      }

      .pv-section {
        display: flex;
        flex-direction: column;
        gap: var(--lui-spacing-fluid-16);
      }

      .pv-section__title {
        margin: 0;
        font-size: var(--lui-brand-typography-font-size-2xs);
        font-weight: var(--lui-typography-weight-semibold);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--lui-color-neutral-text-caption);
      }

      .pv-note {
        margin: 0;
        font-size: var(--lui-brand-typography-font-size-2xs);
        color: var(--lui-color-neutral-text-caption);
      }

      .pv-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--lui-spacing-fixed-16);
      }

      .pv-col {
        display: flex;
        flex-direction: column;
        gap: var(--lui-spacing-fixed-16);
      }

      .pv-ramp {
        display: flex;
        flex-direction: column;
        gap: var(--lui-spacing-fixed-8);
      }

      .pv-ramp__label {
        font-size: var(--lui-brand-typography-font-size-2xs);
        color: var(--lui-color-neutral-text-caption);
      }

      .pv-ramp__steps {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(84px, 1fr));
        gap: var(--lui-spacing-fixed-8);
      }

      .pv-swatch {
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      .pv-swatch__chip {
        display: block;
        height: 56px;
        border-radius: var(--lui-brand-border-radius-md);
        border: var(--lui-border-width-1) solid var(--lui-color-neutral-border-subtle);
      }

      .pv-swatch__step {
        font-size: var(--lui-brand-typography-font-size-3xs);
        font-weight: var(--lui-typography-weight-semibold);
      }

      .pv-swatch__hex {
        font-family: ui-monospace, monospace;
        font-size: var(--lui-brand-typography-font-size-3xs);
        color: var(--lui-color-neutral-text-caption);
        text-transform: uppercase;
      }

      .pv-radius {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
      }

      .pv-radius__box {
        display: block;
        width: 72px;
        height: 72px;
        background: var(--lui-color-primary-background-container);
        border: var(--lui-border-width-1) solid var(--lui-color-primary-border-default);
      }

      .pv-radius__label {
        font-size: var(--lui-brand-typography-font-size-3xs);
        color: var(--lui-color-neutral-text-caption);
      }

      .pv-grid {
        display: grid;
      }

      /* ── Régua de colunas ─────────────────────────────────────── */

      .pv-overlay {
        position: fixed;
        inset: 0;
        z-index: 10;
        display: none;
        pointer-events: none;
      }

      :root[data-grid-overlay='on'] .pv-overlay {
        display: block;
      }

      .pv-overlay__grid {
        display: grid;
        height: 100%;
        max-width: var(--lui-brand-grid-container-1xl);
        margin: 0 auto;
      }

      .pv-overlay__column {
        background: var(--lui-color-primary-background-container);
        opacity: 0.14;
      }

      /* O resumo do breakpoint acompanha a régua: fora dela é ruído sobre a
         composição. */
      .pv-overlay__readout {
        position: absolute;
        left: 50%;
        bottom: var(--lui-spacing-fixed-16);
        transform: translateX(-50%);
        margin: 0;
        padding: var(--lui-spacing-fixed-8) var(--lui-spacing-fixed-16);
        border-radius: var(--lui-brand-border-radius-md);
        background: var(--lui-color-neutral-background-overlay);
        color: var(--lui-color-neutral-text-inverse);
        font-size: var(--lui-brand-typography-font-size-3xs);
        white-space: nowrap;
      }

      .pv-grid__column {
        height: 72px;
        border-radius: var(--lui-brand-border-radius-sm);
        background: var(--lui-color-primary-background-container);
      }

      /* A barra de navegação não cabe em telas estreitas: os links saem antes de
         a linha quebrar. */
      @media (width <= 767px) {
        .pv-topbar__links {
          display: none;
        }
      }
    </style>
  </body>
</html>
