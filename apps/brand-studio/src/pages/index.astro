---
/**
 * Brand Studio — editing the `lui.brand` tokens of a Let's UI brand.
 *
 * The reference brand's DTCG files are read at build time and become the
 * interface's initial state, so the studio never drifts out of sync with what
 * is versioned in `packages/lets-ui-tokens/tokens/brand/`.
 *
 * The interface is built out of the design system's own components: the studio
 * is the first consumer of what it edits. That is only possible because the
 * preview lives in an iframe — the brand being edited never leaks into the
 * editing chrome.
 */
import '@lets-ui/tokens';
import '@lets-ui/styles';
import '@/styles/studio.css';

import foundation from '@tokens/brand/lets-ui/foundation.json';
import light from '@tokens/brand/lets-ui/colors.light.json';
import dark from '@tokens/brand/lets-ui/colors.dark.json';

const templates = { foundation, light, dark };
const meta = { name: "Let's UI", slug: 'lets-ui' };

---

<!doctype html>
<html lang="en" data-brand="lets-ui">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Brand Studio — Let's UI</title>
  </head>
  <body>
    <div class="st" data-studio data-collapsed="false">
      <!-- ── Preview stage ──────────────────────────────────── -->
      <main class="st-stage">
        <div class="st-frame" data-canvas>
          <div class="st-artboard" data-artboard>
            <span class="st-viewport__size" data-viewport-size aria-hidden="true"></span>

            <button
              type="button"
              class="st-viewport__handle st-viewport__handle--left"
              aria-label="Resize preview width"
              data-resize-handle="left"></button>

            <div class="st-viewport" data-viewport-frame>
              <iframe src="/preview" title="Brand preview" data-preview></iframe>
            </div>

            <button
              type="button"
              class="st-viewport__handle st-viewport__handle--right"
              aria-label="Resize preview width"
              data-resize-handle="right"></button>
          </div>
        </div>

        <!-- Canvas controls float over the stage instead of taking a bar of
             their own: the preview keeps the full height. The width comes
             from dragging the canvas's own handles, not from a reading of
             the brand's breakpoints. -->
        <div class="st-toolbar st-float st-float--bottom-end" role="group" aria-label="Zoom">
          <lui-tooltip text="Zoom out" position="top">
            <lui-icon-button size="md" aria-label="Zoom out" data-action="zoom-out">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="5" y="11" width="14" height="2" rx="1" fill="currentColor"/></svg>
            </lui-icon-button>
          </lui-tooltip>

          <button
            type="button"
            class="st-zoom__value"
            aria-label="Reset zoom to 100%"
            data-zoom-value>100%</button>

          <lui-tooltip text="Zoom in" position="top">
            <lui-icon-button size="md" aria-label="Zoom in" data-action="zoom-in">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="5" y="11" width="14" height="2" rx="1" fill="currentColor"/><rect x="11" y="5" width="2" height="14" rx="1" fill="currentColor"/></svg>
            </lui-icon-button>
          </lui-tooltip>
        </div>

        <!-- Stage-level actions, each on its own floating surface. The panel
             toggle sits where the panel docks, its icon pointing the way the
             panel will move; randomizing comes under it, since it acts on
             the whole brand rather than any one field. Each tooltip spells
             out its button's name, and `lui-tooltip` skips describing a
             button with its own name, so a screen reader says it once. -->
        <div class="st-float st-float--top-end st-float-stack">
          <div class="st-toolbar">
            <lui-tooltip text="Hide panel" position="left" data-panel-tooltip>
              <lui-icon-button size="md" aria-label="Hide panel" data-action="toggle-panel">
                <svg class="st-icon st-icon--hide" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8.84467 5.09473C9.13756 4.80183 9.61232 4.80183 9.90522 5.09473L16.2802 11.4697C16.5731 11.7626 16.5731 12.2374 16.2802 12.5303L9.90522 18.9053C9.61232 19.1982 9.13756 19.1982 8.84467 18.9053C8.55178 18.6124 8.55178 18.1376 8.84467 17.8447L14.6894 12L8.84467 6.15527C8.55178 5.86238 8.55178 5.38762 8.84467 5.09473Z"/></svg>
                <svg class="st-icon st-icon--show" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14.0947 5.09473C14.3876 4.80183 14.8624 4.80183 15.1553 5.09473C15.4482 5.38762 15.4482 5.86238 15.1553 6.15527L9.31055 12L15.1553 17.8447C15.4482 18.1376 15.4482 18.6124 15.1553 18.9053C14.8624 19.1982 14.3876 19.1982 14.0947 18.9053L7.71973 12.5303C7.42684 12.2374 7.42684 11.7626 7.71973 11.4697L14.0947 5.09473Z"/></svg>
              </lui-icon-button>
            </lui-tooltip>
          </div>

          <div class="st-toolbar">
            <lui-tooltip text="Randomize brand" position="left">
              <lui-icon-button size="md" aria-label="Randomize brand" data-action="randomize">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 3h5v5"/><path d="M4 20 21 3"/><path d="M21 16v5h-5"/><path d="m15 15 6 6"/><path d="m4 4 5 5"/></svg>
              </lui-icon-button>
            </lui-tooltip>
          </div>
        </div>
      </main>

      <!-- ── Editing panel ──────────────────────────────────── -->
      <aside class="st-panel">
        <header class="st-panel__head">
          <div class="st-identity">
            <lui-input size="md" label="Brand name" data-brand-name></lui-input>
            <lui-input
              size="md"
              label="Identifier"
              hint="Folder under tokens/brand/"
              data-brand-slug></lui-input>
          </div>

        </header>

        <div class="st-panel__body" data-panel></div>

        <footer class="st-panel__foot">
          <lui-tag data-status label="No changes" variant="neutral" size="sm"></lui-tag>

          <lui-button
            size="md"
            block
            label="Export tokens"
            data-action="export"></lui-button>

          <lui-button
            size="md"
            variant="ghost"
            block
            label="Import"
            data-action="import-trigger"></lui-button>

          <input type="file" accept="application/json" multiple hidden data-action="import" />
        </footer>
      </aside>
    </div>

    <script
      is:inline
      type="application/json"
      id="brand-templates"
      set:html={JSON.stringify({ templates, meta })}
    />

    <script>
      import '@lets-ui/components';
      import { mountStudio } from '@/lib/studio.js';

      const { templates, meta } = JSON.parse(
        document.getElementById('brand-templates').textContent
      );

      mountStudio({
        root: document.querySelector('[data-studio]'),
        templates,
        meta,
      });
    </script>
  </body>
</html>
