{
  "name": "@lets-ui/components",
  "version": "1.13.1",
  "description": "Let's UI Web Components package",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/mateusvillain/lets-ui#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/mateusvillain/lets-ui.git",
    "directory": "packages/lets-ui-components"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "design-system",
    "ui-components",
    "lets-ui"
  ],
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./locales/en": "./dist/locales/en.js",
    "./locales/pt-BR": "./dist/locales/pt-BR.js",
    "./locales/pt-PT": "./dist/locales/pt-PT.js",
    "./locales/es": "./dist/locales/es.js",
    "./locales/fr": "./dist/locales/fr.js",
    "./locales/de": "./dist/locales/de.js",
    "./locales/ja": "./dist/locales/ja.js",
    "./locales/it": "./dist/locales/it.js",
    "./locales/zh-CN": "./dist/locales/zh-CN.js",
    "./locales/zh-TW": "./dist/locales/zh-TW.js",
    "./alert": "./dist/components/alert/alert.js",
    "./breadcrumb": "./dist/components/breadcrumb/breadcrumb.js",
    "./breadcrumb-item": "./dist/components/breadcrumb/breadcrumb-item.js",
    "./button": "./dist/components/button/button.js",
    "./card": "./dist/components/card/card.js",
    "./checkbox": "./dist/components/checkbox/checkbox.js",
    "./drawer": "./dist/components/drawer/drawer.js",
    "./dropdown-menu": "./dist/components/dropdown-menu/dropdown-menu.js",
    "./divider": "./dist/components/divider/divider.js",
    "./icon-button": "./dist/components/icon-button/icon-button.js",
    "./input": "./dist/components/input/input.js",
    "./link": "./dist/components/link/link.js",
    "./modal": "./dist/components/modal/modal.js",
    "./otp-input": "./dist/components/otp-input/otp-input.js",
    "./pagination": "./dist/components/pagination/pagination.js",
    "./radio": "./dist/components/radio/radio.js",
    "./select": "./dist/components/select/select.js",
    "./shortcut": "./dist/components/shortcut/shortcut.js",
    "./switch": "./dist/components/switch/switch.js",
    "./tabs": "./dist/components/tabs/tabs.js",
    "./tag": "./dist/components/tag/tag.js",
    "./tooltip": "./dist/components/tooltip/tooltip.js",
    "./textarea": "./dist/components/textarea/textarea.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "clean": "rm -rf dist",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "@lets-ui/styles": "workspace:*",
    "@lets-ui/tokens": "workspace:*",
    "@types/node": "^22.0.0",
    "sass": "^1.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  }
}
